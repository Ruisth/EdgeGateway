# =============================================================================
# C2DTA Edge Gateway — environment configuration
# =============================================================================
# Copy this file to `.env` (gitignored) and replace every value before
# running `docker compose up`. The .env file is consumed by docker-compose.yml
# and by services/ditto/nginx/generate-htpasswd.sh.
#
# All values below are placeholders. Do NOT use them in production.

# ---------- Ditto (Digital Twin platform) ----------
DITTO_USER=ditto
DITTO_PASS=change-me-ditto
DITTO_DEVOPS_USER=devops
DITTO_DEVOPS_PASSWORD=change-me-devops

# ---------- CouchDB (Fabric state databases) ----------
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me-couchdb

# ---------- Hyperledger Indy (von-network) ----------
# Steward seed for the local dev ledger. 32 chars. The same value MUST be
# used by every compose file (root and services/indy/) or the generated
# genesis files diverge and wallets registered on one pool fail on the other.
# Dev-only; never reuse for any real deployment.
INDY_LEDGER_SEED=000000000000000000000000Steward1

# ---------- ACA-Py wallet keys (one per agent) ----------
# Wallet keys encrypt each agent's Askar SQLite wallet. Treat as secrets.
ACAPY_CONSORTIUM_WALLET_KEY=change-me-consortium-wallet-key
ACAPY_OEM_WALLET_KEY=change-me-oem-wallet-key
ACAPY_CONSUMER_A_WALLET_KEY=change-me-consumer-a-wallet-key
ACAPY_EGW_WALLET_KEY=change-me-egw-wallet-key
ACAPY_SD_WALLET_KEY=change-me-sd-wallet-key
