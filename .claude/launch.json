{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "DIDComm Agent",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "didcomm_agent.api:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--app-dir", "services/didcomm-agent/src"],
      "port": 8000
    },
    {
      "name": "EGW Controller",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "egw_controller.api:app", "--host", "0.0.0.0", "--port", "8090", "--reload", "--app-dir", "services/egw-controller/src"],
      "port": 8090
    },
    {
      "name": "SD Simulator (MQTT)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["services/smart-device-simulator/examples/run_simulator.py"],
      "port": 8883
    }
  ]
}
